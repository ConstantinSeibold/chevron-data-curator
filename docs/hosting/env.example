# copy to .env next to compose.yaml

# where the images are (filled by an admin) and where projects and accounts are kept
CHEVRON_DATA=/srv/chevron/data
CHEVRON_PROJECTS=/srv/chevron/projects

# owner of the files Chevron writes there: `id -u` and `id -g`
UID=1000
GID=1000

# --profile caddy: the domain whose DNS points at this server
CHEVRON_DOMAIN=chevron.example.org

# --profile tunnel: the token of a Cloudflare tunnel (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=

# only for gated models (dinov3*): a Hugging Face read token
HF_TOKEN=

# the GPU: needs the NVIDIA driver and nvidia-container-toolkit on the host
COMPOSE_FILE=compose.yaml:compose.gpu.yaml
TORCH_INDEX=https://download.pytorch.org/whl/cu128
# no NVIDIA GPU instead:
# COMPOSE_FILE=compose.yaml
# TORCH_INDEX=https://download.pytorch.org/whl/cpu

# RAM the container may use before it is restarted; leave the host a few GB
CHEVRON_MEM_LIMIT=12g
